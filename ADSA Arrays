#include <stdio.h>

int main() {
    int aqi[24];
    int i, highest, poorCount = 0;
    float sum = 0, average;

    printf("Enter 24 AQI readings:\n");
    for(i = 0; i < 24; i++) {
        printf("Hour %d: ", i + 1);
        scanf("%d", &aqi[i]);
    }

    highest = aqi[0];

    for(i = 0; i < 24; i++) {
        if(aqi[i] > highest)
            highest = aqi[i];

        if(aqi[i] > 200)
            poorCount++;

        sum += aqi[i];
    }

    average = sum / 24;

    printf("\nHighest AQI Value = %d\n", highest);
    printf("Number of 'Poor' AQI Readings (AQI > 200) = %d\n", poorCount);
    printf("Average AQI = %.2f\n", average);

    return 0;
}